# ==============================================================================
# ZYCONOMES INSTITUTIONAL BANKING - VARIÁVEIS DE AMBIENTE (PRODUÇÃO & STAGING)
# ==============================================================================
# NUNCA comite valores reais em repositórios públicos.
# Copie este arquivo para .env e preencha as credenciais.

# Servidor HTTP Core
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Banco de Dados & Pool Multiplexado (PgBouncer)
# ATENÇÃO: A aplicação conecta na porta 6432 (PgBouncer).
# Use a porta 5432 (Postgres direto) APENAS para rodar scripts de migração DDL.
DATABASE_URL=postgresql://zyco_admin:zyco_secret_vault_2026@pgbouncer:6432/zyconomes_prod?sslmode=disable
DIRECT_DATABASE_URL=postgresql://zyco_admin:zyco_secret_vault_2026@postgres:5432/zyconomes_prod?sslmode=disable

# Cache em Memória & Idempotência Atômica (Redis)
REDIS_URL=redis://:zyco_redis_auth_2026@redis:6379/0
IDEMPOTENCY_TTL_SECONDS=300

# Mensageria & Dead Letter Exchange (RabbitMQ)
RABBITMQ_URL=amqp://zyco_rabbit:zyco_rabbit_pass@rabbitmq:5672
RABBITMQ_EXCHANGE=zyconomes_exchange
RABBITMQ_QUEUE=fila_emails_cadastro
RABBITMQ_DLX=zyconomes_dlx
RABBITMQ_DLQ=zyconomes_emails_dlq
WORKER_PREFETCH=50
MAX_EMAIL_RETRIES=3

# Serviço de Disparo de E-mail / OTP (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.zyco_production_key_placeholder
EMAIL_FROM=no-reply@zyconomes.com.br

# Segurança de Sessão & Chave Mestre
JWT_SECRET=super_secret_elliptic_key_zyconomes_bank_production_2026
PBKDF2_ITERATIONS=100000
